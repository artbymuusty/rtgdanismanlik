# Deployment-level fallback domain (lib/site-config.ts). Used for
# canonical/OG URLs. Set to the real production domain.
NEXT_PUBLIC_SITE_URL=https://rtgdanismanlik.example.com

# WhatsApp number for the "Yolculuğunu Konuşalım" / "WhatsApp'tan Yaz" CTAs
# (digits only or with formatting — non-digits are stripped). Leave empty
# to hide every WhatsApp CTA on the site; no placeholder number is ever
# shown in its place.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Preview only — leave unset/false in production. When "true", the
# Mentorluk and Öğrenci Hikayeleri sections render clearly-labeled DEMO
# content (lib/content/*.demo.ts) instead of staying hidden, so you can
# see the design before real mentors/stories exist. Real visitors must
# never see this on by accident, which is why every demo card also shows
# a visible "Örnek" badge regardless of this flag.
NEXT_PUBLIC_SHOW_DEMO_CONTENT=

# Independent of NEXT_PUBLIC_SHOW_DEMO_CONTENT above — safe to leave
# "true" in production. When no real LinkedIn/Instagram/X URL is set in
# lib/site-config.ts, this fills the footer's social icons with the
# platform's own homepage instead of hiding them, so the feature is
# visible/clickable before real accounts exist. Never fabricates an RTG
# account: the accessible name always discloses "(örnek hesap)", and a
# real URL in lib/site-config.ts always wins over this fallback.
NEXT_PUBLIC_SHOW_SOCIAL_LINKS=
