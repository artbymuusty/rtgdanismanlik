# Canonical origin (lib/site-config.ts) used for canonical/hreflang/sitemap/OG
# URLs. Set to the real production domain. If unset on Vercel, the project's
# production *.vercel.app domain (VERCEL_PROJECT_PRODUCTION_URL) is used.
NEXT_PUBLIC_SITE_URL=https://rtgdanismanlik.example.com

# WhatsApp number for the "Yolculuğunu Konuşalım" / "WhatsApp'tan Yaz" CTAs
# (digits only or with formatting — non-digits are stripped). Leave empty
# to hide every WhatsApp CTA on the site; no placeholder number is ever
# shown in its place.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Preview only — leave unset/false in production. When "true", the
# Mentörlük and Öğrenci Hikâyeleri sections render clearly-labeled DEMO
# content (lib/content/*.demo.ts) instead of staying hidden, so you can
# see the design before real mentors/stories exist. Real visitors must
# never see this on by accident, which is why every demo card also shows
# a visible "Örnek" badge regardless of this flag.
NEXT_PUBLIC_SHOW_DEMO_CONTENT=

# Independent of NEXT_PUBLIC_SHOW_DEMO_CONTENT above — safe to leave
# "true" in production. When no real LinkedIn/Instagram/X URL is set in
# lib/site-config.ts, this fills the footer's social icons with the
# platform's own homepage instead of hiding them, so the feature is
# visible/clickable before real accounts exist. Never fabricates an RTG
# account: the accessible name always discloses "(örnek hesap)", and a
# real URL in lib/site-config.ts always wins over this fallback.
NEXT_PUBLIC_SHOW_SOCIAL_LINKS=

# --- Server-only (never NEXT_PUBLIC_*, never sent to the browser) ---
# The Google Apps Script Web App backing /basvuru and /bize-katilin (see
# integrations/google-apps-script/Code.gs + GOOGLE_APPS_SCRIPT_SETUP.md).
# Without these, both forms validate normally but return an honest
# "not connected yet" error instead of a fake success.
GOOGLE_APPS_SCRIPT_URL=
# A long random string you generate yourself (e.g. `openssl rand -hex 32`)
# and store in BOTH Vercel's env vars and the Apps Script project's Script
# Properties (as API_SECRET) — never commit the real value.
GOOGLE_APPS_SCRIPT_SECRET=

# The password for /crm (the internal lead-management workspace) — a long
# random string you generate yourself (e.g. `openssl rand -hex 32`), set
# ONLY in Vercel's Production env vars. Never NEXT_PUBLIC_, never sent to
# the browser, never logged. Unrelated to GOOGLE_APPS_SCRIPT_SECRET above:
# that one authenticates server-to-Apps-Script traffic, this one
# authenticates a human at /crm/login. Rotating it instantly signs out
# every open CRM session (session cookies are signed with this value).
CRM_ADMIN_SECRET=
